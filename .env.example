# Postgres connection string from the Neon console (Connect, pooled)
DATABASE_URL=

# Neon Auth: the Auth URL shown in the Neon console under Auth
NEON_AUTH_BASE_URL=

# Any random string of 32+ characters, e.g. from: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails allowed to review reports at /community/review (never shown to anyone)
MODERATOR_EMAILS=
